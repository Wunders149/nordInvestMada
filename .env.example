# Environment Configuration
NODE_ENV=development
PORT=3000

# Email Provider: "resend" (HTTP API — no SMTP ports needed, recommended) or "smtp"
MAIL_PROVIDER=smtp

# Resend (HTTP API) — simplest, no SMTP ports; verify your domain then use contact@yourdomain.com
RESEND_API_KEY=
RESEND_FROM=Nord Invest Madagascar <contact@nordinvestmada.com>

# SMTP fallback (used when MAIL_PROVIDER=smtp)
# Gmail: host smtp.gmail.com, port 587 (App Password, enable 2FA)
# Brevo:  host smtp-relay.brevo.com, port 587 or 2525 (2525 recommended on Render/cloud hosts, 587 is often blocked)
#        + SMTP_FROM must be a sender verified in Brevo
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
ADMIN_EMAIL=

# SUPABASE Configuration
SUPABASE_SERVICE_KEY=
SUPABASE_URL=

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Google Analytics
GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# Admin Dashboard Credentials (set these — fallback if admin_users table is empty)
ADMIN_USER=
ADMIN_PASS=

# Site URL
SITE_URL=https://www.nordinvest.mg
