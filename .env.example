# Environment Configuration
NODE_ENV=development
PORT=3000

# Email Configuration (SMTP)
# Gmail default: host smtp.gmail.com, port 587 (App Password required, enable 2FA)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ADMIN_EMAIL=

# SUPABASE Configuration
SUPABASE_SERVICE_KEY=
SUPABASE_URL=

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Google Analytics
GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# Admin Dashboard Credentials (set these — fallback if admin_users table is empty)
ADMIN_USER=
ADMIN_PASS=

# Site URL
SITE_URL=https://www.nordinvest.mg
